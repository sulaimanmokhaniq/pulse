DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
REDIS_URL=redis://localhost:6379
PORT=3000
# Optional
STREAM_KEY=pulse:events
STREAM_MAXLEN=100000
RATE_LIMIT_PER_MINUTE=600
MAX_BODY_BYTES=512kb
# Worker (runs inside the API process)
WORKER_ENABLED=true
WORKER_BATCH_SIZE=500
WORKER_POLL_MS=1000
WORKER_MAX_IDLE_POLL_MS=30000
# Seeds the Phase 1 project on startup (and via `npm run seed`)
SEED_PROJECT_NAME=Demo Shop
SEED_API_KEY=

# Base URL of the Pulse API
PULSE_API_URL=http://localhost:3000
# Secret (sk_) key for the project. Server-side only; never exposed to the browser.
PULSE_SECRET_KEY=sk_...
# Optional. Lets you create and delete flags. Unset = those actions are off.
# Anyone can still switch existing flags and change their rollout (the demo).
DASHBOARD_ADMIN_PASSWORD=
